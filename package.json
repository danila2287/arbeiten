    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/scss/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/scss/**/*.scss\" --fix",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.1",
    "sharp": "^0.34.2",
    "stylelint": "^16.20.0",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "svgo": "^3.3.2",
    "vite": "^6.3.5",
    "vite-plugin-image-optimizer": "^1.1.8"
  },
  "engines": {
    "node": ">=20"
  }
