{
  "name": "arbeiten",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Сайт аренды мебели для небольших мероприятий в Москве",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages": "node scripts/generate.mjs",
